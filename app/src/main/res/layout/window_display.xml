<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_window">

    <!-- Video & Surface Container (100% full bleed inside rounded window) -->
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#000000">

        <SurfaceView
            android:id="@+id/surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/hint_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minHeight="180dp"
            android:orientation="vertical"
            android:padding="16dp">

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/msg_connecting"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Top Overlay (Xiaomi Style Handle & Pop-out Action Pill) -->
    <LinearLayout
        android:id="@+id/top_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="5dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- Minimal 3-dots handle (Drag to move, Tap to toggle controls) - No background per user request -->
        <LinearLayout
            android:id="@+id/handle_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_drag_handle_dots"
                android:contentDescription="Handle" />
        </LinearLayout>

        <!-- Pop-out Top Action Pill (Xiaomi Style) -->
        <HorizontalScrollView
            android:id="@+id/top_pill_scroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/top_pill"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_floating_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <!-- Connected Device Title (optional compact label) -->
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="80dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:paddingStart="4dp"
                    android:paddingEnd="6dp"
                    android:text="@string/app_name"
                    android:textColor="#B0BEC5"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Rotate button -->
                <ImageView
                    android:id="@+id/iv_rotate"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_btn_ripple"
                    android:src="@drawable/ic_nav_rotate"
                    android:contentDescription="@string/rotate_button" />

                <!-- Screenshot button -->
                <ImageView
                    android:id="@+id/iv_screenshot"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_btn_ripple"
                    android:src="@drawable/ic_screenshot"
                    android:contentDescription="@string/btn_screenshot" />

                <!-- Record button -->
                <ImageView
                    android:id="@+id/iv_record"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_btn_ripple"
                    android:src="@drawable/ic_record"
                    android:contentDescription="@string/btn_record" />

                <!-- Record timer -->
                <TextView
                    android:id="@+id/tv_record_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="#FF4444"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:text="00:00"
                    android:visibility="gone"
                    android:background="@drawable/bg_btn_ripple" />

                <!-- Minimize / Collapse -->
                <ImageView
                    android:id="@+id/iv_mini"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_btn_ripple"
                    android:src="@drawable/ic_minimize"
                    android:contentDescription="Minimize" />

                <!-- Close floating window -->
                <ImageView
                    android:id="@+id/iv_close"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_btn_ripple"
                    android:src="@drawable/ic_close_small"
                    android:contentDescription="Close" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Bottom Navigation Bar Overlay (Xiaomi Style Floating Nav Pill) -->
    <LinearLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="6dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <HorizontalScrollView
            android:id="@+id/bottom_pill_scroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/bottom_pill"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_floating_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:id="@+id/action_power"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_btn_ripple"
                    android:src="@drawable/ic_nav_power"
                    android:contentDescription="@string/power_button" />

                <ImageView
                    android:id="@+id/action_back"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_btn_ripple"
                    android:src="@drawable/ic_nav_back"
                    android:contentDescription="@string/back_button" />

                <ImageView
                    android:id="@+id/action_home"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_btn_ripple"
                    android:src="@drawable/ic_nav_home"
                    android:contentDescription="@string/home_button" />

                <ImageView
                    android:id="@+id/action_menu"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_btn_ripple"
                    android:src="@drawable/ic_nav_tasks"
                    android:contentDescription="@string/appswitch_button" />

                <ImageView
                    android:id="@+id/action_vol_down"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_btn_ripple"
                    android:src="@drawable/ic_nav_vol_down"
                    android:contentDescription="@string/voldown_button" />

                <ImageView
                    android:id="@+id/action_vol_up"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_btn_ripple"
                    android:src="@drawable/ic_nav_vol_up"
                    android:contentDescription="@string/volup_button" />

                <!-- Pin toggle button -->
                <ImageView
                    android:id="@+id/action_pin"
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_btn_ripple"
                    android:src="@drawable/ic_nav_pin"
                    android:alpha="0.45"
                    android:contentDescription="Pin Navigation" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Corner Drag-to-Resize Handle (Hidden per user request) -->
    <ImageView
        android:id="@+id/iv_resize"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:src="@drawable/ic_nav_resize"
        android:contentDescription="Resize" />

</FrameLayout>
