<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- SurfaceView: sized by ConstraintSet ratio, centered in available space -->
    <SurfaceView
        android:id="@+id/decoder_surface"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/nav_button_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constrainedWidth="true"
        app:layout_constrainedHeight="true"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintDimensionRatio="H,16:9" />

    <!-- Remote Speaker layout (shown only when audio_only is true) -->
    <LinearLayout
        android:id="@+id/layout_audio_only_speaker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/nav_button_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_nav_vol_up"
            app:tint="#4DB6AC"
            android:contentDescription="@string/title_remote_speaker" />

        <TextView
            android:id="@+id/tv_speaker_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/title_remote_speaker"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_speaker_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/switch_audio_only"
            android:textColor="#B0BEC5"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_speaker_minimize"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:text="@string/btn_minimize"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:icon="@drawable/ic_minimize"
            app:iconTint="#FFFFFF"
            app:iconSize="18dp"
            app:backgroundTint="#33FFFFFF"
            app:cornerRadius="22dp"
            style="@style/Widget.Material3.Button.TonalButton" />
    </LinearLayout>

    <!-- Navigation button bar: anchored to bottom, elevated above video -->
    <LinearLayout
        android:id="@+id/nav_button_bar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#EE16191A"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="visible"
        android:elevation="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Power Button -->
        <ImageView
            android:id="@+id/power_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_btn_ripple"
            android:src="@drawable/ic_nav_power"
            android:contentDescription="@string/power_button" />

        <!-- Back Button -->
        <ImageView
            android:id="@+id/back_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_btn_ripple"
            android:src="@drawable/ic_nav_back"
            android:contentDescription="@string/back_button" />

        <!-- Home Button -->
        <ImageView
            android:id="@+id/home_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_btn_ripple"
            android:src="@drawable/ic_nav_home"
            android:contentDescription="@string/home_button" />

        <!-- App Switch / Recents -->
        <ImageView
            android:id="@+id/appswitch_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_btn_ripple"
            android:src="@drawable/ic_nav_tasks"
            android:contentDescription="@string/appswitch_button" />

        <!-- Volume Down -->
        <ImageView
            android:id="@+id/vol_down_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_btn_ripple"
            android:src="@drawable/ic_nav_vol_down"
            android:contentDescription="@string/voldown_button" />

        <!-- Volume Up -->
        <ImageView
            android:id="@+id/vol_up_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_btn_ripple"
            android:src="@drawable/ic_nav_vol_up"
            android:contentDescription="@string/volup_button" />

        <!-- Rotate Button -->
        <ImageView
            android:id="@+id/rotate_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_btn_ripple"
            android:src="@drawable/ic_nav_rotate"
            android:contentDescription="@string/rotate_button" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- Screenshot pull-tab: top-left corner                               -->
    <!-- Drag from top-left toward bottom-right (≥80dp) to take screenshot -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/tab_screenshot"
        android:layout_width="52dp"
        android:layout_height="64dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_pull_tab_screenshot"
        android:alpha="0.82"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:elevation="16dp"
        android:paddingBottom="4dp">

        <!-- Screenshot icon -->
        <ImageView
            android:id="@+id/iv_tab_screenshot"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_screenshot"
            android:contentDescription="@string/btn_screenshot" />

        <!-- Drag hint: small arrow pointing right-down -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↘"
            android:textColor="#99FFFFFF"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- Record pull-tab: top-right corner                                   -->
    <!-- Drag from top-right toward bottom-left (≥80dp) to start/stop rec  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/tab_record"
        android:layout_width="52dp"
        android:layout_height="64dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_pull_tab_record"
        android:alpha="0.82"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="16dp"
        android:paddingBottom="4dp">

        <!-- Record icon (shown when not recording) -->
        <ImageView
            android:id="@+id/iv_tab_record"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_record"
            android:contentDescription="@string/btn_record"
            android:visibility="visible" />

        <!-- Recording timer (shown when recording, replaces icon) -->
        <TextView
            android:id="@+id/tv_tab_record_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF4444"
            android:textSize="10sp"
            android:textStyle="bold"
            android:text="00:00"
            android:visibility="gone" />

        <!-- Drag hint: small arrow pointing left-down -->
        <TextView
            android:id="@+id/tv_tab_record_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↙"
            android:textColor="#99FFFFFF"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
